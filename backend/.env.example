# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่า — .env ถูก gitignore ไว้แล้ว
# บน production ใช้ environment จริงหรือ secret manager ไม่ใช่ไฟล์นี้

APP_ENV=development          # development | staging | production
LOG_LEVEL=debug              # debug | info | warn | error
HTTP_PORT=8080
SHUTDOWN_TIMEOUT=15s

# ── Database ────────────────────────────────────────────────
# รันบนเครื่อง: ชี้ localhost | รันใน docker compose: compose ทับให้เป็น postgres:5432 เอง
DATABASE_URL=postgres://relaycontent:relaycontent_dev@127.0.0.1:15432/relaycontent?sslmode=disable
POSTGRES_PORT=15432
POSTGRES_PASSWORD=relaycontent_dev
DB_MAX_CONNS=10
DB_AUTO_MIGRATE=true

# ── Redis ───────────────────────────────────────────────────
# Redis เป็นท่อส่งงานเท่านั้น งานจริงอยู่ใน publish_jobs บน Postgres
REDIS_URL=redis://localhost:6379/0

# ── Auth ────────────────────────────────────────────────────
# production ต้องยาว >= 32 ตัว และห้ามมีคำว่า "dev-"
JWT_SECRET=dev-เปลี่ยนค่านี้ก่อนขึ้น-production
ACCESS_TOKEN_TTL=15m
GOOGLE_CLIENT_ID=
REFRESH_TOKEN_TTL=720h

# FCM HTTP v1 (optional in development; keep the private key in a secret manager)
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
# Paste the service-account PEM and preserve newlines as \n when using one line.
FCM_PRIVATE_KEY=

# ── Token encryption ────────────────────────────────────────
# ใช้เข้ารหัส access/refresh token ของ TikTok และ API key ของผู้ใช้ ก่อนเก็บลง DB
# สร้างคีย์ใหม่: go run ./cmd/genkey
#
# รูปแบบ: <version>:<base64 32 ไบต์> คั่นด้วยจุลภาค
# หมุนคีย์: เพิ่ม version ใหม่ต่อท้าย "ห้ามลบของเก่า" ไม่งั้นแถวเดิมจะถอดไม่ได้อีกเลย
#   ENCRYPTION_KEYS=1:<คีย์เก่า>,2:<คีย์ใหม่>
ENCRYPTION_KEYS=1:REPLACE_ME_RUN_GO_RUN_CMD_GENKEY

# ── URL สาธารณะ + deep link กลับเข้าแอป ──────────────────────
# PUBLIC_BASE_URL ต้องเป็น URL ที่ TikTok เข้าถึงได้จริง (ตอน dev ใช้ ngrok/cloudflared ได้)
PUBLIC_BASE_URL=http://localhost:8080
APP_SCHEME=relaycontent

# ── TikTok ──────────────────────────────────────────────────
# เว้นว่างได้ ระบบยังบูตปกติ แต่ endpoint ที่เกี่ยวจะตอบ PROVIDER_NOT_CONFIGURED
# เอาค่ามาจาก https://developers.tiktok.com หลังสร้าง app
#
# TIKTOK_REDIRECT_URI ต้องตรงกับที่ลงทะเบียนไว้ในหน้า app ของ TikTok เป๊ะ ๆ
# รูปแบบ: <PUBLIC_BASE_URL>/v1/oauth/tiktok/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
TIKTOK_SCOPES=user.info.basic,video.publish,video.upload
# ปิดได้ถ้า TikTok app ที่ตั้งไว้ไม่รองรับ PKCE
TIKTOK_USE_PKCE=true

# ── Object storage (Cloudflare R2) ──────────────────────────
# เว้นว่างได้ ระบบยังบูตปกติ แต่ /v1/media จะตอบ PROVIDER_NOT_CONFIGURED
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# R2_ENDPOINT ทับ URL ที่สร้างจาก account id — ใช้ชี้ไป MinIO ตอน dev เท่านั้น
#   docker compose --profile localstorage up -d
#   R2_ENDPOINT=http://localhost:9000
#   R2_ACCESS_KEY_ID=relaycontent
#   R2_SECRET_ACCESS_KEY=relaycontent_dev
#   R2_BUCKET=relaycontent-media
R2_ENDPOINT=

# V0.1 จำกัดวิดีโอ 100MB เพื่อใช้ presigned PUT ก้อนเดียว ยังไม่ทำ multipart
MEDIA_MAX_VIDEO_BYTES=104857600
MEDIA_MAX_IMAGE_BYTES=10485760
UPLOAD_URL_TTL=30m
# ต้องนานพอให้ TikTok ดึงไฟล์จนจบ (PULL_FROM_URL) ไม่ใช่แค่พอให้แอปดู preview
DOWNLOAD_URL_TTL=2h

# ── CORS ────────────────────────────────────────────────────
# เว้นว่าง = ไม่มีเบราว์เซอร์ไหนเรียก API ได้ (ค่าปลอดภัยสำหรับ production)
# แอปมือถือไม่ต้องใช้ค่านี้ เพราะไม่ส่ง Origin header
# ตอน dev ที่รัน Flutter web: http://localhost:5000
CORS_ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
